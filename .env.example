# URL base del backend Solari (FastAPI). En desarrollo corre en el puerto 9000.
VITE_API_BASE_URL=http://localhost:9000/api/v1

# Client ID de Google OAuth (tipo "Aplicación web"). Público, no es secreto.
# Debe coincidir con GOOGLE_CLIENT_ID del backend. Si queda vacío, no se muestra el botón.
VITE_GOOGLE_CLIENT_ID=
